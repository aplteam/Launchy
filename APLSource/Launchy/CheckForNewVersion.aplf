 {r}←CheckForNewVersion dummy;tag;msg;rc;dmx;api;flag;url;bv
 r←⍬
 :If CheckNetInterface
     api←⎕NEW ##.GitHubAPIv3(,⊂'aplteam')
     :Trap 0
         tag←api.GetLatestTag'Launchy'
     :Else
         TellCommunicationWithGitHubFailed'Launchy'
         :Return
     :EndTrap
     flag←0<≢bv←api.CheckForUpdate'Launchy'({⍵↑⍨¯1+⌊/⍵⍳'+-'}2⊃Version)
     :If ~flag
         TellLaunchyIsUp2Date ⍬
     :Else
         msg←⊂'There is a better version (',bv,') available on GitHub.'
         msg,←'' 'Would you like to download this version?'
         :If YesOrNo msg
             :Trap 0
                 url←api.GetRelease'Launchy' 'EXE'
             :Else
                 dmx←⎕DMX
                 TellCommunicationWithGitHubFailed'Launchy'
                 :Return
             :EndTrap
             :If 0=≢url
                 n TellErrorWhileCheckingForBetterVersion''
             :Else
                 U.GoToWebPage url
                 ShowMsg2'Check the download folder of your default browser.'
             :EndIf
         :EndIf
     :EndIf
 :EndIf
⍝Done
